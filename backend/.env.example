PORT=3000
# 127.0.0.1 in production (behind nginx)
HOST=0.0.0.0
DATABASE_URL=postgres://localhost:5432/mervynstunner
ADMIN_API_KEY=replace-with-a-long-random-value
ALLOWED_ORIGIN=http://localhost:5173

# X posts on the site. With a bearer token the latest posts sync automatically;
# without one, add posts by link: npm run posts:add -- <url>
X_HANDLE=MervynStunner
X_BEARER_TOKEN=
# Or OAuth 2.0 user tokens (scopes: tweet.read users.read offline.access), renewed automatically:
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_SYNC_HOURS=6
